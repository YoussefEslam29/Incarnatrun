# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a secret with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database  (PostgreSQL)
# ---------------------------------------------------------------------------
# Local via the bundled docker-compose.yml:
#   postgresql://incarnatrun:incarnatrun@localhost:5432/incarnatrun?schema=public
# Or a hosted Postgres from Neon / Supabase.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# One of: local | vercel-blob | s3
# `local` needs no credentials and writes to ./.data/storage — use it for dev.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Required when STORAGE_DRIVER=s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=
# Optional, for S3-compatible services such as Cloudflare R2 or MinIO
S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Avatar generation engine
# ---------------------------------------------------------------------------
# One of: builtin | metaperson | readyplayerme | avaturn
#
# `builtin` is fully implemented and needs no credentials. It generates a
# rigged, Mixamo-compatible GLB locally, so the whole product works before a
# vendor has been chosen. The other providers are adapter stubs kept behind the
# same interface — see docs/AVATAR_ENGINE.md.
AVATAR_ENGINE_PROVIDER=builtin

# Required only for the vendor providers
AVATAR_SDK_API_KEY=
AVATAR_SDK_API_URL=
